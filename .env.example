# Neon Postgres — use the POOLED connection string (…-pooler.…neon.tech).
# Without this the app still fully works, but Playbook/Session state stays
# per-browser (localStorage) and saved plans are unavailable.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require"

# Passphrase that unlocks cross-device sync (any string you choose).
APP_PASSWORD="pick-a-passphrase"

# Optional: separate cookie-signing secret (defaults to APP_PASSWORD).
# AUTH_SECRET="another-random-string"
